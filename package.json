{
  "name": "waf-checker-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite-node": "^6.0.0",
    "vitest": "~4.1.12",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "miniflare": {
      "undici": "7.29.1"
    }
  },
  "scripts": {
    "pretest": "npm run build",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "bash scripts/e2e-test-wafs.sh",
    "validate:aws:cfn": "vite-node scripts/validate-aws-cfn.mjs",
    "build": "npm run build --workspace=@waf-checker/core && npm run build --workspace=@waf-checker/cli",
    "version:bump": "npm version --no-git-tag-version --workspace=@waf-checker/core --workspace=@waf-checker/cli",
    "version:check": "node packages/core/scripts/sync-version.mjs --check",
    "dev:worker": "npm run dev --workspace=packages/worker",
    "simulate:schedule": "node scripts/simulate-schedule.mjs"
  }
}
