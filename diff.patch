+    default: 'GET'
+  categories:
+    description: 'Comma-separated payload categories (e.g., "SQL Injection,XSS,RCE")'
+    required: false
+  threshold:
+    description: 'Minimum required protection score percentage (0-100). Fails the action if score is lower'
+    required: false
+  fail-on-bypass:
+    description: 'Fail step if any attack bypass is detected (true/false)'
+    required: false
+    default: 'false'
+  enhanced:
+    description: 'Use enhanced payload set (true/false)'
+    required: false
+    default: 'false'
+  advanced:
+    description: 'Use advanced bypass payloads (true/false)'
+    required: false
+    default: 'false'
+  auto-detect:
+    description: 'Auto-detect WAF vendor first (true/false)'
+    required: false
+    default: 'false'
+  encoding:
+    description: 'Use encoding and obfuscation variations (true/false)'
+    required: false
+    default: 'false'
+  http-manipulation:
+    description: 'Run HTTP manipulation tests (true/false)'
+    required: false
+    default: 'false'
+  sarif-output:
